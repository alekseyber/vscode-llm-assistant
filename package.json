{
  "name": "vscode-llm-assistant",
  "displayName": "VS Code LLM Assistant",
  "description": "AI-ассистент: чат, редактирование, автокомплит, агентный кодинг",
  "publisher": "alekseyber",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alekseyber/vscode-llm-assistant.git"
  },
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmAssistant.chat.focus",
        "title": "LLM Assistant: Открыть чат"
      },
      {
        "command": "llmAssistant.chat.addSelection",
        "title": "LLM Assistant: Добавить выделение в контекст"
      },
      {
        "command": "llmAssistant.edit.selection",
        "title": "LLM Assistant: Редактировать выделенный код"
      },
      {
        "command": "llmAssistant.autocomplete.toggle",
        "title": "LLM Assistant: Вкл/Выкл автокомплит"
      },
      {
        "command": "llmAssistant.apply.start",
        "title": "LLM Assistant: Запустить агентный режим"
      },
      {
        "command": "llmAssistant.selectProvider",
        "title": "LLM Assistant: Выбрать провайдер"
      },
      {
        "command": "llmAssistant.openHistory",
        "title": "LLM Assistant: Открыть историю запусков"
      }
    ],
    "keybindings": [
      {
        "command": "llmAssistant.chat.focus",
        "key": "ctrl+shift+l"
      },
      {
        "command": "llmAssistant.edit.selection",
        "key": "ctrl+i"
      },
      {
        "command": "llmAssistant.apply.start",
        "key": "ctrl+shift+a"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmAssistant",
          "title": "LLM Assistant",
          "icon": "media/icons/chat.svg"
        }
      ]
    },
    "views": {
      "llmAssistant": [
        {
          "type": "webview",
          "id": "llmAssistant.chat",
          "name": "Чат"
        },
        {
          "type": "webview",
          "id": "llmAssistant.history",
          "name": "История"
        },
        {
          "type": "webview",
          "id": "llmAssistant.orchestrator",
          "name": "Оркестратор"
        }
      ]
    },
    "configuration": {
      "title": "LLM Assistant",
      "properties": {
        "llmAssistant.defaultProvider": {
          "type": "string",
          "default": "openai",
          "description": "Провайдер по умолчанию"
        },
        "llmAssistant.defaultModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Модель по умолчанию"
        },
        "llmAssistant.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить автокомплит"
        },
        "llmAssistant.autocomplete.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "Задержка перед запросом автокомплита (ms)"
        },
        "llmAssistant.chat.maxContextTokens": {
          "type": "number",
          "default": 4096,
          "description": "Максимум токенов контекста чата"
        },
        "llmAssistant.chat.systemPrompt": {
          "type": "string",
          "default": "Ты — AI-ассистент в VS Code. Отвечай кратко, по-русски, по делу. Без воды и длинных вступлений. Если спрашивают про код — предлагай конкретные исправления. Формат ответа: markdown.",
          "description": "Системный промпт для чата"
        },
        "llmAssistant.chat.includeOpenFile": {
          "type": "boolean",
          "default": true,
          "description": "Автоматически прикреплять содержимое открытого файла к запросу"
        },
        "llmAssistant.chat.summaryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить сжатие обрезанной истории в summary при переполнении контекста"
        },
        "llmAssistant.chat.summaryModel": {
          "type": "string",
          "default": "",
          "description": "Модель для генерации summary (по умолчанию — текущая модель чата)"
        },
        "llmAssistant.chat.summaryTriggerTokens": {
          "type": "number",
          "default": 2048,
          "description": "Минимальное количество токенов обрезанных сообщений для запуска summarization"
        },
        "llmAssistant.chat.agentSystemPrompt": {
          "type": "string",
          "default": "Ты — AI-агент в VS Code. Инструменты: list_files, search_files, read_file, write_file, replace_in_file, run_terminal. Для изучения: list_files → search_files → read_file. Для запуска: run_terminal. Отвечай кратко, по-русски.",
          "description": "Системный промпт для режима агента"
        },
        "llmAssistant.apply.maxIterations": {
          "type": "number",
          "default": 20,
          "description": "Максимум шагов агента"
        },
        "llmAssistant.apply.allowedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read_file",
              "write_file",
              "replace_in_file",
              "patch_file",
              "list_files",
              "search_files",
              "run_terminal"
            ]
          },
          "default": [],
          "description": "Список разрешённых инструментов агента. Пустой массив = все инструменты разрешены."
        },
        "llmAssistant.apply.requireConfirmation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "write_file",
            "replace_in_file",
            "run_terminal"
          ],
          "description": "Инструменты, требующие подтверждения пользователя перед выполнением"
        },
        "llmAssistant.agent.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Модель для агентного режима (apply). Если не задана — используется defaultModel"
        },
        "llmAssistant.agent.requireConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Запрашивать подтверждение перед записью/изменением файлов"
        },
        "llmAssistant.agentsMd.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Автоматически добавлять AGENTS.md из корня workspace в system prompt агента и чата"
        },
        "llmAssistant.debug": {
          "type": "boolean",
          "default": false,
          "description": "Включить DEBUG логи"
        },
        "llmAssistant.retry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить автоматические повторные попытки при ошибках API (429, 5xx, сетевые ошибки)"
        },
        "llmAssistant.retry.maxRetries": {
          "type": "number",
          "default": 3,
          "description": "Максимальное количество повторных попыток при ошибках"
        },
        "llmAssistant.retry.requestTimeout": {
          "type": "number",
          "default": 60,
          "description": "Таймаут запроса в секундах (по истечении — ретрай)"
        },
        "llmAssistant.providers": {
          "type": "object",
          "default": {},
          "description": "Настройки провайдеров (baseUrl, apiKey, models)"
        },
        "llmAssistant.mcp.servers": {
          "type": "array",
          "default": [],
          "description": "MCP-серверы для подключения. Каждый сервер: { name, command, args?, env? }",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Уникальное имя сервера (используется как префикс для инструментов)"
              },
              "command": {
                "type": "string",
                "description": "Команда для запуска (npx, node, python3 — spawn в PATH)"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Аргументы командной строки"
              },
              "env": {
                "type": "object",
                "description": "Переменные окружения для процесса сервера"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src/ test/ --ext .ts",
    "precommit": "npm run lint && npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:mocked": "node test/run-mocked.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/mocha": "^10.x",
    "@types/node": "^20.x",
    "@types/sinon": "^17.x",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^7.x",
    "@typescript-eslint/parser": "^7.x",
    "@vscode/test-electron": "^2.x",
    "@vscode/vsce": "^2.x",
    "eslint": "^8.56.0",
    "mocha": "^10.x",
    "nyc": "^17.x",
    "sinon": "^18.x",
    "ts-loader": "^9.x",
    "ts-node": "^10.9.2",
    "typescript": "^5.x",
    "webpack": "^5.x",
    "webpack-cli": "^5.x"
  },
  "dependencies": {
    "highlight.js": "^11.x",
    "marked": "^12.x",
    "openai": "^4.x"
  },
  "mocha": {
    "ui": "tdd",
    "timeout": 10000,
    "color": true
  }
}
