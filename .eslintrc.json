{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-case-declarations": "off",
    "no-useless-escape": "off",
    "no-empty": "warn",
    "no-constant-condition": "warn"
  },
  "ignorePatterns": [
    "out/",
    "dist/",
    "node_modules/",
    ".vscode-test/"
  ]
}
